# ai-fetch-healer configuration
# Priority order for OpenRouterProvider key resolution:
# 1) AI_HEALER_OPENROUTER_KEY
# 2) OPENROUTER_API_KEY
# 3) GEMINI_API_KEY (legacy fallback)

# Recommended primary key
AI_HEALER_OPENROUTER_KEY=your_openrouter_key_here

# Optional compatibility aliases (set only if needed)
# OPENROUTER_API_KEY=your_openrouter_key_here
# GEMINI_API_KEY=your_key_here

# --- Model selection (Phase A: no code edit needed when a model is deprecated) ---
# Override the model per provider WITHOUT touching code. Comma-separate to define
# a fallback chain - the first available model wins; a deprecated one (404) auto-
# falls through to the next. Unset = sensible registry default.
# AI_HEALER_OPENROUTER_MODEL=openai/gpt-4o-mini,google/gemini-flash-1.5
# AI_HEALER_GEMINI_MODEL=gemini-2.5-flash
# AI_HEALER_GROQ_MODEL=llama-3.3-70b-versatile
# AI_HEALER_OLLAMA_MODEL=llama3.1

# Other provider keys (only if you use that provider)
# AI_HEALER_GROQ_KEY=your_groq_key_here
# AI_HEALER_OLLAMA_URL=http://localhost:11434/v1/chat/completions